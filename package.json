{
  "name": "prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first interview prep: 4,068 LeetCode problems, spaced repetition, and an AI tutor that refuses to give you the answer.",
  "scripts": {
    "dev": "bun run --hot src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "ingest": "bun run src/server/ingest.ts",
    "build:ui": "bunx vite build",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "hono": "^4.6.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.1"
  }
}
