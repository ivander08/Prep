# Data — the SQLite database and anything fetched from LeetCode
data/

# Dependencies
node_modules/

# Build output
dist/

# Rust build output (the Tauri shell). `Cargo.lock` and `icons/` ARE committed: this is an
# application, so the lockfile is the reproducible build, and the icons are generated from
# `src/ui/assets/logo.svg` but are checked in because `tauri build` reads them directly.
src-tauri/target/
src-tauri/gen/

# Secrets
.env
.env.local
# Any other dotenv variant (`.env.production`, `.env.development.local`, …). `.env.example` is
# re-included because it is the documented template and holds no values.
.env.*
!.env.example
*.pem
*.key
*.p12

# SQLite, including the WAL and shared-memory sidecars. `data/` covers the default location, but
# `PREP_DB_PATH` can point anywhere, and a `prep.db-wal` beside the repo root would otherwise be
# committed.
*.db
*.db-wal
*.db-shm

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Scratch
*.log
