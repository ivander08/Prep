{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prep",
  "version": "0.1.0",
  "identifier": "com.prep.desktop",
  "build": {
    "frontendDist": "../dist/ui",
    "beforeBuildCommand": "bun run build:desktop",
    "beforeDevCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["../dist/desktop/prep-server"],
    "resources": {
      "../dist/desktop/resources": "resources"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
